# Copy to .env and fill in real values before running `npm run dev`.

# Database connection (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://appointment_user:appointment_pass@localhost:5432/appointment_db"

# Server
PORT=3000
CORS_ORIGIN="http://localhost:5174"

# n8n webhooks (optional — app still works if n8n is not running; notifications are fire-and-forget)
N8N_WEBHOOK_URL="http://localhost:5678/webhook/appointment-created"
N8N_STATUS_WEBHOOK_URL="http://localhost:5678/webhook/appointment-status-changed"

# JWT secret for admin auth — generate with: openssl rand -base64 32
# The server fails fast on boot if this is missing or still set to the placeholder.
JWT_SECRET="REPLACE_ME_WITH_OUTPUT_OF_openssl_rand_base64_32"

# Admin bootstrap — created automatically on first server boot if no admin exists
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-before-publishing"
